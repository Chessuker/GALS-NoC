# =============================================================================
# Vivado build artifacts
#
# ทุกอย่างในนี้ Vivado สร้างใหม่ได้จาก .xpr + .srcs/ ที่ยัง track อยู่
# ก่อนหน้านี้ถูก commit เข้ามาด้วยทั้งหมด (528 ไฟล์) ทำให้ทุกครั้งที่ synth/impl
# หรือจับ ILA มีไฟล์เปลี่ยนร้อยกว่าไฟล์ อ่าน git status ไม่รู้เรื่อง
# และ merge ชนกันที่ไฟล์ไบนารี (.dcp/.wdb/.ila) ซึ่ง resolve ด้วยมือไม่ได้
#
# ที่ยัง track ต่อ (ห้ามใส่ในนี้):
#   GALS_Packet-Based_Fabric.xpr            ตัวโปรเจกต์
#   GALS_Packet-Based_Fabric.srcs/          RTL, testbench, constraint, .xci ตัวจริง
#   formal/  logs/                         สคริปต์ formal + หลักฐานการรัน (logs/hw, logs/sim)
#   scripts/  docs/                        สคริปต์ build/วิเคราะห์ + เอกสาร
# =============================================================================

# ---- ผลลัพธ์ synthesis / implementation (สร้างใหม่ได้ด้วย launch_runs)
GALS_Packet-Based_Fabric.runs/

# ---- cache ของ IP และ webtalk
GALS_Packet-Based_Fabric.cache/

# ---- output product ของ IP (สร้างใหม่ได้จาก .srcs/sources_1/ip/*/*.xci)
GALS_Packet-Based_Fabric.gen/

# ---- ไฟล์ simulation ที่ Vivado gen ให้ (export_simulation)
GALS_Packet-Based_Fabric.sim/
GALS_Packet-Based_Fabric.ip_user_files/

# ---- state ของ Hardware Manager + waveform config ของ ILA
#      การจับ ILA ที่มีความหมายจริงเก็บเป็น log ไว้ใน logs/hw/ แล้ว
GALS_Packet-Based_Fabric.hw/

# ---- โฟลเดอร์ชั่วคราวของ Vivado
.Xil/
**/.Xil/

# ---- journal / log ที่ Vivado ทิ้งไว้ตอนรัน (ไม่ใช่ log ใน logs/sim/ logs/hw)
/vivado*.jou
/vivado*.log
/vivado_pid*.str
/hs_err_pid*.log
/.jobs/

# ---- ไฟล์ที่ Vivado แอบเขียนทิ้งไว้ ไม่ใช่ซอร์ส (โผล่ทั้งที่รากโปรเจกต์และใน srcs)
dfx_runtime.txt

# ---- ผลลัพธ์ของ SymbiYosys (formal/<task>_<mode>/) — formal/.gitignore คุมอยู่แล้ว
#      ใส่ซ้ำไว้กันเผลอ commit จากรากโปรเจกต์
formal/*/

# ---- ผลลัพธ์ของ scripts/tools/combine_sv.py (เขียนลงโฟลเดอร์ที่รันอยู่) generate ใหม่ได้เสมอ
/combined.sv
/scripts/tools/combined.sv

# ---- ตั้งค่าเฉพาะเครื่องของ Claude Code (เดิมกันไว้แค่ใน global ignore ของเครื่องนี้)
.claude/settings.local.json

# ---- รูปต้นฉบับของ scripts/host/demos/image_noc_test.py ตั้งใจไม่เก็บใน repo
hee.png

# ---- Python cache
__pycache__/
*.pyc

# ---- ไฟล์ที่ OS สร้างเอง
Thumbs.db
desktop.ini
.DS_Store

# ---- ของเก่าที่เก็บไว้ในเครื่องเท่านั้น ไม่ขึ้น repo (ดู garbage/README.md ในเครื่อง)
#      history เต็มอยู่ใน Chessuker/GALS-NoC-Archive
garbage/

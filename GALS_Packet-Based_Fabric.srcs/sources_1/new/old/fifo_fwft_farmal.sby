[tasks]
bmc
prove
cover

[options]
bmc: mode bmc
prove: mode prove
cover: mode cover
bmc: depth 40
prove: depth 40
cover: depth 50
multiclock on

[engines]
smtbmc boolector
smtbmc yices

[script]
read_verilog -sv -formal -D FORMAL_TOP_INTEGRATION async_fifo.sv
read_verilog -sv -formal -D FORMAL_TOP_INTEGRATION sync_2stage.sv
read_verilog -sv -formal -D FORMAL_TOP_INTEGRATION gray_counter.sv
read_verilog -sv -formal dual_port_ram.sv
read_verilog -sv -formal fwft_wrapper.sv
read_verilog -sv -formal async_fifo_fwft.sv

chparam -set DATA_WIDTH 8 -set ADDR_WIDTH 3 async_fifo_fwft
prep -top async_fifo_fwft

[files]
sync_2stage.sv
gray_counter.sv
dual_port_ram.sv
async_fifo.sv
fwft_wrapper.sv
async_fifo_fwft.sv

# =============================================================================
# vc_input_buffer — formal
#
# ทุก flit ที่เข้า router ต้องผ่านโมดูลนี้ก่อน แต่มันไม่เคยถูกพิสูจน์เลย
# บล็อก FORMAL ใน .sv พิสูจน์สามอย่างพร้อมกันด้วย shadow FIFO แบบ black-box:
#   assert_valid_iff_occupied / _ready_iff_room  - ธงว่าง/เต็มตรงกับของจริง
#   assert_head_tlast / _tdest / _tdata          - หัวคิวคือของที่เขียนเข้าไปเป๊ะ
#                                                  (ครอบ demux + pack/unpack + ลำดับ)
#   assert_no_cross_vc_write                     - flit ไม่ข้ามเลน
#
# ทำไมเป็น bmc ไม่ใช่ prove:
#   การเทียบ "เนื้อในคิวเงา" กับ "เนื้อในคิวจริง" ไม่เป็น inductive โดยธรรมชาติ
#   induction เริ่มจากสถานะที่ shadow กับ mem ไม่ตรงกันได้ตั้งแต่ไซเคิลแรก
#   จะทำให้เป็น unbounded ต้องอ้าง mem ภายใน sync_fifo เข้ามาผูกเป็น invariant
#   ซึ่งทำให้ property กลายเป็น white-box (ผูกกับ implementation ของ FIFO)
#   จึงเลือก bounded ที่ลึกพอกลืนคิวทั้งใบแล้วคายออกจนหมดหลายรอบแทน
#   เจ็ดโมดูลที่เหลือยังเป็น prove ตามเดิม — ดู HANDOFF
#
# DEPTH ย่อจาก 16 เหลือ 2 และ DATA_W จาก 8 เหลือ 4 เพื่อให้ solver ไหว
# (DEPTH 4 ทำให้ z3 ใช้เวลาเกินครึ่งชั่วโมงต่อ 10 สเต็ป — คิวเงาสามชุด
#  บวก mem ของ FIFO ทำให้ทฤษฎี array บาน)
# ตรรกะไม่ขึ้นกับค่าจริง คิวลึกกว่าแค่วนนานกว่า
#
#   cd formal && sby -f vc_input_buffer.sby
# =============================================================================

[tasks]
bmc
cover

[options]
bmc: mode bmc
bmc: depth 16
cover: mode cover
cover: depth 16

[engines]
smtbmc --nopresat z3

[script]
plugin -i slang
read_slang -D FORMAL --top vc_input_buffer -G DATA_W=4 -G DEPTH=2 sync_fifo.sv vc_input_buffer.sv
prep -top vc_input_buffer
# คิวเงา + mem ของ FIFO เป็น array ซึ่ง z3 แก้ช้ามาก (เกิน 28 นาทีที่ depth 16)
# memory_map กาง array เป็น flip-flop ธรรมดา ขนาดจิ๋วอยู่แล้วจึงไม่มีอะไรเสีย
memory_map
opt -fast

[files]
../GALS_Packet-Based_Fabric.srcs/sources_1/new/sync_fifo.sv
../GALS_Packet-Based_Fabric.srcs/sources_1/new/vc_input_buffer.sv

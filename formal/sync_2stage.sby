# =============================================================================
# sync_2stage — formal
#
# ตัว sync 2 ชั้นที่ใช้ข้ามโดเมนนาฬิกาทั่วดีไซน์
#
# เขียนใหม่ใน formal/ แทนสคริปต์เดิมใน sources_1/new/old/ ซึ่งรันไม่ได้อยู่แล้ว:
# มัน [files] ชื่อไฟล์แบบไม่มีพาธ แต่ซอร์สจริงอยู่ใน new/ ไม่ใช่ old/
# (อีกเหตุผลที่ของพวกนี้ไม่เคยถูกรันเลย)
#
#   cd formal && sby -f sync_2stage.sby
# =============================================================================

[tasks]
prove
cover

[options]
prove: mode prove
prove: depth 20
cover: mode cover
cover: depth 20

[engines]
smtbmc z3

[script]
read_verilog -sv -formal -D FORMAL_TOP_INTEGRATION sync_2stage.sv
prep -top sync_2stage

[files]
../GALS_Packet-Based_Fabric.srcs/sources_1/new/sync_2stage.sv

# =============================================================================
# packet_arbiter — formal
#
# ไม่เคยมีไฟล์นี้มาก่อน: arbiter_formal.sby ใน sources_1/new/old/ ชี้ไปที่
# hw_queue_descriptor ซึ่งเป็นโมดูลจากโปรเจกต์อื่น ไม่เคยแตะ arbiter เลย
#
# พิสูจน์:
#   assert_onehot                       - grant เป็น one-hot เสมอ
#   assert_channel_lock                 - ห้ามแย่งช่องกลางแพ็กเกจ (bug #1)
#   assert_abort_only_when_source_gone  - timeout ยิงได้เฉพาะตอนต้นทางไม่มีข้อมูล
#                                         = backpressure ทำให้ abort ไม่ได้
#
# ข้อที่สามคือหัวใจ: มันคือหลักประกันว่า timeout ที่เพิ่มเข้าไปแก้ bug #5
# ไม่ได้เปิดทาง bug #1 กลับมา
#
# STALL_LOG ย่อเหลือ 3 (8 ไซเคิล) เพื่อให้ solver ไปถึงสถานะ abort ได้ใน depth ที่ไหว
# ตรรกะไม่ขึ้นกับค่าจริง 10 — ของจริงแค่ต้องรอนานกว่า
#
#   cd formal && sby -f packet_arbiter.sby
# =============================================================================

[tasks]
prove
cover

[options]
prove: mode prove
prove: depth 24
cover: mode cover
cover: depth 24

[engines]
smtbmc z3

[script]
read_verilog -sv -formal packet_arbiter.sv
chparam -set STALL_LOG 3 packet_arbiter
prep -top packet_arbiter

[files]
../GALS_Packet-Based_Fabric.srcs/sources_1/new/packet_arbiter.sv

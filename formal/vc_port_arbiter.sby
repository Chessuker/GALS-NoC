# =============================================================================
# vc_port_arbiter — formal
#
# บล็อก `ifdef FORMAL ในไฟล์นี้ถูกเขียน/แก้ไว้ตอนแก้ bug #3 แต่ไม่เคยถูกรันเลย
# เพราะไม่มี .sby ชี้มา — สภาพเดียวกับที่ทำให้ assert_channel_lock ของ
# packet_arbiter เป็นเท็จอยู่นานโดยไม่มีใครรู้
#
# พิสูจน์ (ดูตัวไฟล์ vc_port_arbiter.sv):
#   assert_inv_starve_cap             - starve_cnt ไม่ทะลุเพดาน
#   assert_inv_wait_cap / _sync       - ตัวนับ formal เดินตรงกับตัวนับ RTL
#   assert_override_only_at_limit     - override ยกได้เฉพาะตอนถึงลิมิต
#   assert_no_vc1_during_override     - ระหว่าง override ที่ VC0 เดินได้ VC1 ต้องหยุด
#   assert_vc1_yields_when_stalled    - VC1 ห้ามยึดสายตอนขยับ flit ไม่ได้ (หัวใจ bug #3)
#   assert_no_grant_without_credit    - ห้าม grant VC1 ตอนไม่มี credit
#   assert_vc_mutex                   - VC0/VC1 ห้ามได้ไฟเขียวพร้อมกัน
#   assert_bounded_starvation         - รอเกินลิมิตแล้วต้องเกิด override จริง
#
# STARVE_LIMIT ย่อเหลือ 4 เพื่อให้ solver ไปถึงสถานะ override ได้ใน depth ที่ไหว
# ตรรกะไม่ขึ้นกับค่าจริง 64 — ของจริงแค่รอนานกว่า
#
#   cd formal && sby -f vc_port_arbiter.sby
# =============================================================================

[tasks]
prove
cover

[options]
prove: mode prove
prove: depth 24
cover: mode cover
cover: depth 24

[engines]
smtbmc z3

[script]
read_verilog -sv -formal packet_arbiter.sv
read_verilog -sv -formal vc_port_arbiter.sv
chparam -set STARVE_LIMIT 4 vc_port_arbiter
prep -top vc_port_arbiter

[files]
../GALS_Packet-Based_Fabric.srcs/sources_1/new/packet_arbiter.sv
../GALS_Packet-Based_Fabric.srcs/sources_1/new/vc_port_arbiter.sv

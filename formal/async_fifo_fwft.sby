# =============================================================================
# async_fifo_fwft — formal
#
# FIFO แบบ first-word-fall-through ที่ห่อ async_fifo อีกชั้น ตัวที่ gals_node_wrapper ใช้จริง
#
# ตั้งแต่ 2026-11-03 รันแบบ multiclock และพิสูจน์ข้อมูล/ลำดับจากปลายถึงปลาย:
#   FORMAL_ASYNC_FIFO_TOP      - เปิด property + invariant ทั้งชุดของ core_fifo
#                                (ดู async_fifo.sby) ซึ่ง assume แค่สายรีเซ็ตกับใช้
#                                prog_full_thresh[0] เป็นตัวเลือก — ทั้งคู่เป็นอินพุตของ top
#                                ที่นี่เหมือนกัน จึงไม่มี assumption ตกบนสายที่มีตัวขับ
#   FORMAL_ASYNC_FIFO_FWFT_TOP - ตาม flit ที่ core_fifo ติดตามต่อผ่าน fwft_wrapper:
#     assert_user_tracked_data   - ผู้ใช้อ่านครั้งที่ f_k ได้ flit ตัวนั้น ค่าเดิม
#     inv_*                      - core อ่าน = ผู้ใช้อ่าน + ที่ค้างใน wrapper,
#                                  และ flit อยู่ช่องไหนของ wrapper (out/skid/กำลังมา)
#   บล็อก FORMAL ของ fwft_wrapper เอง (assert_no_overflow, _skid_physics,
#   _empty_status, reset) ไม่มี guard จึงเปิดอยู่ด้วยเสมอ
#
# ก่อนหน้านี้สคริปต์ปล่อย multiclock off (ยุบสองนาฬิกาเป็นอันเดียว) และ assertion
# ทั้งหมดเป็นของ gray_counter / sync_2stage / fwft_wrapper — ไม่มีอะไรเรื่องข้อมูล
# ตอนนี้ gray_counter กับ sync_2stage ถูกปิดด้วย FORMAL_TOP_INTEGRATION
# (พิสูจน์แยกในสคริปต์ของตัวเอง และใช้ $onehot ซึ่ง slang ไม่รองรับ)
#
# ขนาด: prove ใช้ขนาดจริง (ADDR_WIDTH 4, DATA_WIDTH 13) cover ย่อเหลือ ADDR_WIDTH 2
# ข้อจำกัดเหมือน async_fifo.sby: พิสูจน์ระดับ RTL เท่านั้น (ไม่ใช่ physical CDC / bus skew),
# RAM ไม่มี ECC, รีเซ็ตขอบเขต cold start (ไม่ครอบ runtime soft reset)
#
#   wsl -d Ubuntu-24.04 -- bash formal/run_wsl.sh async_fifo_fwft.sby
# =============================================================================

[tasks]
prove
cover

[options]
multiclock on
prove: mode prove
prove: depth 12
cover: mode cover
cover: depth 40

[engines]
smtbmc yices

[script]
plugin -i slang
prove: read_slang -D FORMAL -D FORMAL_TOP_INTEGRATION -D FORMAL_ASYNC_FIFO_TOP -D FORMAL_ASYNC_FIFO_FWFT_TOP --top async_fifo_fwft -G ADDR_WIDTH=4 -G DATA_WIDTH=13 dual_port_ram.sv gray_counter.sv sync_2stage.sv async_fifo.sv fwft_wrapper.sv async_fifo_fwft.sv
cover: read_slang -D FORMAL -D FORMAL_TOP_INTEGRATION -D FORMAL_ASYNC_FIFO_TOP -D FORMAL_ASYNC_FIFO_FWFT_TOP --top async_fifo_fwft -G ADDR_WIDTH=2 -G DATA_WIDTH=4 dual_port_ram.sv gray_counter.sv sync_2stage.sv async_fifo.sv fwft_wrapper.sv async_fifo_fwft.sv
prep -top async_fifo_fwft
memory_map
opt -fast

[files]
../GALS_Packet-Based_Fabric.srcs/sources_1/new/dual_port_ram.sv
../GALS_Packet-Based_Fabric.srcs/sources_1/new/gray_counter.sv
../GALS_Packet-Based_Fabric.srcs/sources_1/new/sync_2stage.sv
../GALS_Packet-Based_Fabric.srcs/sources_1/new/async_fifo.sv
../GALS_Packet-Based_Fabric.srcs/sources_1/new/fwft_wrapper.sv
../GALS_Packet-Based_Fabric.srcs/sources_1/new/async_fifo_fwft.sv

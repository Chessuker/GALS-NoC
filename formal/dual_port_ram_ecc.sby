# =============================================================================
# dual_port_ram_ecc — formal
#
# RAM + SECDED — พิสูจน์ว่าเขียนอะไรลงไปแล้วอ่านกลับได้ค่านั้น
#   (tb_ecc_secded พิสูจน์ทุกกรณีแบบ exhaustive แล้ว อันนี้เป็น unbounded)
#
# เขียนใหม่ใน formal/ แทนสคริปต์เดิมใน sources_1/new/old/ ซึ่งรันไม่ได้อยู่แล้ว:
# มัน [files] ชื่อไฟล์แบบไม่มีพาธ แต่ซอร์สจริงอยู่ใน new/ ไม่ใช่ old/
# (อีกเหตุผลที่ของพวกนี้ไม่เคยถูกรันเลย)
#
#   cd formal && sby -f dual_port_ram_ecc.sby
# =============================================================================

[tasks]
prove
cover

[options]
prove: mode prove
prove: depth 20
cover: mode cover
cover: depth 20

[engines]
smtbmc z3

[script]
read_verilog -sv -formal  dual_port_ram.sv
read_verilog -sv -formal  ecc_secded_encode_8b.sv
read_verilog -sv -formal  ecc_secded_decode_8b.sv
read_verilog -sv -formal  dual_port_ram_ecc.sv
prep -top dual_port_ram_ecc

[files]
../GALS_Packet-Based_Fabric.srcs/sources_1/new/dual_port_ram.sv
../GALS_Packet-Based_Fabric.srcs/sources_1/new/ecc_secded_encode_8b.sv
../GALS_Packet-Based_Fabric.srcs/sources_1/new/ecc_secded_decode_8b.sv
../GALS_Packet-Based_Fabric.srcs/sources_1/new/dual_port_ram_ecc.sv

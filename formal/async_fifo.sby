# =============================================================================
# async_fifo — formal
#
# async FIFO ข้ามโดเมน — ตัวที่ทุก flit ต้องผ่านตอนข้ามขอบ GALS
#   หมายเหตุ: เมื่อ FORMAL ถูกนิยาม async_fifo จะใช้ dual_port_ram ธรรมดา
#   (ไม่ใช่ dual_port_ram_ecc) ตามที่เขียนไว้ในตัวไฟล์ ECC จึงต้องพิสูจน์แยก
#
# เขียนใหม่ใน formal/ แทนสคริปต์เดิมใน sources_1/new/old/ ซึ่งรันไม่ได้อยู่แล้ว:
# มัน [files] ชื่อไฟล์แบบไม่มีพาธ แต่ซอร์สจริงอยู่ใน new/ ไม่ใช่ old/
# (อีกเหตุผลที่ของพวกนี้ไม่เคยถูกรันเลย)
#
#   cd formal && sby -f async_fifo.sby
# =============================================================================

[tasks]
prove
cover

[options]
prove: mode prove
prove: depth 20
cover: mode cover
cover: depth 20

[engines]
smtbmc z3

[script]
read_verilog -sv -formal -D FORMAL_TOP_INTEGRATION dual_port_ram.sv
read_verilog -sv -formal -D FORMAL_TOP_INTEGRATION gray_counter.sv
read_verilog -sv -formal -D FORMAL_TOP_INTEGRATION sync_2stage.sv
read_verilog -sv -formal -D FORMAL_TOP_INTEGRATION async_fifo.sv
prep -top async_fifo

[files]
../GALS_Packet-Based_Fabric.srcs/sources_1/new/dual_port_ram.sv
../GALS_Packet-Based_Fabric.srcs/sources_1/new/gray_counter.sv
../GALS_Packet-Based_Fabric.srcs/sources_1/new/sync_2stage.sv
../GALS_Packet-Based_Fabric.srcs/sources_1/new/async_fifo.sv

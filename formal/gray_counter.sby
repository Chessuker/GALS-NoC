# =============================================================================
# gray_counter — formal
#
# ตัวนับ Gray: ต้องเปลี่ยนทีละ 1 บิตเท่านั้น (หัวใจของ CDC ใน async FIFO)
#
# เขียนใหม่ใน formal/ แทนสคริปต์เดิมใน sources_1/new/old/ ซึ่งรันไม่ได้อยู่แล้ว:
# มัน [files] ชื่อไฟล์แบบไม่มีพาธ แต่ซอร์สจริงอยู่ใน new/ ไม่ใช่ old/
# (อีกเหตุผลที่ของพวกนี้ไม่เคยถูกรันเลย)
#
#   cd formal && sby -f gray_counter.sby
# =============================================================================

[tasks]
prove
cover

[options]
prove: mode prove
prove: depth 20
cover: mode cover
cover: depth 20

[engines]
smtbmc z3

[script]
read_verilog -sv -formal -D FORMAL_TOP_INTEGRATION gray_counter.sv
prep -top gray_counter

[files]
../GALS_Packet-Based_Fabric.srcs/sources_1/new/gray_counter.sv
